# CPU demo image. NOT built this round. Linux x86-64.
FROM python:3.12-slim-bookworm
WORKDIR /app
# Place wheelhouse at build time; do not pip install from PyPI in air-gapped use.
COPY llm_runtime_kits/projects/L04_local_serve /app/L04
COPY llm_runtime_kits/shared /app/shared
ENV PYTHONPATH=/app/shared
ENV LLM_MODE=mock
EXPOSE 8090
# CMD would be uvicorn; omitted so this file is documentation-complete without implying an image exists.
# CMD ["python","-m","uvicorn","L04.src.server:app","--host","0.0.0.0","--port","8090"]
